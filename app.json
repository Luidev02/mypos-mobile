{
  "expo": {
    "name": "myPOS",
    "slug": "mypos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myposmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "myPOS usa la cámara para escanear códigos de barras de productos en el punto de venta.",
        "NSPhotoLibraryUsageDescription": "myPOS usa tu galería para seleccionar imágenes de productos y categorías."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.clicfstudios.hiropos",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "myPOS usa la cámara para escanear códigos de barras de productos en el punto de venta."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "myPOS usa tu galería para seleccionar imágenes de productos y categorías."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5c8fd5e-a4ba-499a-b2c2-c3793451b353"
      }
    }
  }
}
